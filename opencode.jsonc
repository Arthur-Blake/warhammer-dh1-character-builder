{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 4000
    },
    "buffer": "15%"
  },
  "agents": {
    "compaction": {
      "model": "opencode-go/glm-5.3-flash"
    }
  }
}
